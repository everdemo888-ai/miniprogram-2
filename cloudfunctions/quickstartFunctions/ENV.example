# 云函数环境变量示例（复制到「微信云开发控制台 → 云函数 → 配置 → 环境变量」）
# 若使用「云托管」Docker 部署（见项目根目录 Dockerfile），在云托管服务里同样配置这些变量，并额外设置：
#   TCB_ENV_ID=你的云开发环境ID   # 与小程序 app.js 中 globalData.env 一致；容器内 cloud.init 依赖此变量
#
# 免费聚合接口（devtool / TenAPI）常限流、502、解析失败，生产环境请使用签约商用解析。

# --- 上线防护（可选，见 docs/PRODUCTION_CHECKLIST.md）---
# 单用户每 24 小时（滚动窗口）最多创建多少个 video_jobs；默认 120；设为 0 表示不限制（不推荐生产）
# MAX_VIDEO_JOBS_PER_USER_24H=120
# 激励视频发放积分：同一用户每个自然日最多成功发放次数；默认 40；设为 0 表示不限制（不推荐生产）
# MAX_AD_REWARD_GRANTS_PER_DAY=40
# 关闭原 QuickStart 云函数演示（createCollection / sales CRUD / getMiniProgramCode 等）；上线建议设为 1
# DISABLE_TEMPLATE_CLOUD_TYPES=1

# --- 推荐：商用解析（GET，URL 中用 {{url}} 占位，会被替换为 encodeURIComponent(用户粘贴的链接)）---
# VIDEO_PARSE_URL=https://你的服务商域名/api/parse?url={{url}}&key=你的密钥
# 返回 JSON 里视频直链字段路径（点号分隔），例如 data.videoUrl 或 data.data.url
# VIDEO_PARSE_JSON_PATH=data.videoUrl

# 可选：第二路解析（主路失败时自动尝试）
# VIDEO_PARSE_URL_EXTRA=https://备用服务商/parse?url={{url}}
# VIDEO_PARSE_JSON_PATH_EXTRA=data.url

# 若接口要求 Header 鉴权（二选一或按服务商文档）
# VIDEO_PARSE_API_KEY=你的key

# --- BugPK（api.bugpk.com）：在 VIDEO_PARSE_URL 之后、龟龟呀/HelloTik 之前请求 ---
# 默认已使用官方短视频聚合（无需配置）：https://api.bugpk.com/api/short_videos ，GET ?url=
# 覆盖为其它地址：
# BUGPK_UNIFIED_URL=https://example.com/api/parse
# 关闭 BugPK 或改回「按平台子路径」（douyin / ksjx / xhs / bilibili）：
# BUGPK_DISABLE=1
# BUGPK_USE_PLATFORM_ROUTING=1
# BUGPK_UNKNOWN_URL=https://api.bugpk.com/api/douyin
# DOUYIN_BUGPK_URL=  DOUYIN_BUGPK_DISABLE=1
# KUAISHOU_BUGPK_URL=  KUAISHOU_BUGPK_DISABLE=1
# XHS_BUGPK_URL=  XHS_BUGPK_DISABLE=1
# B 站在「按平台路由」模式下也默认走 short_videos；仅当需旧版子接口时设：BILIBILI_BUGPK_URL=https://api.bugpk.com/api/bilibili
# BILIBILI_BUGPK_DISABLE=1

# --- 可选：仅抖音 devtool 系 GET/POST 的地址（BugPK 已在 extractVideoMeta 中单独尝试）---
# VIDEO_PARSE_DOUYIN_URL=https://www.devtool.top/api/douyin/parse

# --- 可选：抖音第二备用（GET，须含 {{url}}）---
# DOUYIN_PARSE_FALLBACK_URL=https://example.com/parse?link={{url}}
# DOUYIN_PARSE_FALLBACK_JSON_PATH=data.video.url

# --- 可选：TenAPI 地址（默认 https://tenapi.cn/v2/video，遇 502 可换自建反代）---
# TENAPI_VIDEO_URL=https://tenapi.cn/v2/video

# --- 快手备用：api.tjit.net（需 key；BugPK 失败后再走）---
# 需在 https://api.tjit.net/user/key 申请 key，否则接口会报「密钥 key 不正确」
# VIDEO_PARSE_KUAISHOU_KEY=你的key
# 若文档要求参数名不是 key，可设：VIDEO_PARSE_KUAISHOU_KEY_PARAM=key
# 或换整条接口：VIDEO_PARSE_KUAISHOU_URL=https://你的域名/kuaishou?url={{url}}（需自行适配返回字段时建议改用 VIDEO_PARSE_URL）

# --- 龟龟呀聚合 api.guiguiya.com（先 GET：apiKey+url，再 GET：type=json&apiKey+url）---
# 说明：该接口在服务商侧多为「抖音解析」，默认仅当链接识别为抖音时才请求龟龟呀；快手等会走内置快手或其它线路。
# GUIGUIYA_API_KEY=你的apiKey
# 默认 HTTPS（云函数出站更稳）：GUIGUIYA_API_BASE=https://api.guiguiya.com/api/video_qsy/juhe
# 若返回 JSON 字段与自动识别不一致，可设：GUIGUIYA_JSON_PATH=data.url
# 仍对所有平台先尝试龟龟呀（若你套餐支持多平台）：GUIGUIYA_ONLY_DOUYIN=0
# 龟龟呀失败时中断并只显示龟龟呀错误（不再走 devtool/TenAPI）：GUIGUIYA_STRICT=1（默认关闭=自动回退内置线路，真机更稳）

# --- HelloTik（https://www.hellotik.app/api/parse）---
# 未带 Token 时接口会返回 {"error":"Authentication required"}，需在 hellotik 用户后台/开发者处获取 Token。
# HELLOTIK_API_TOKEN=你的Token
# HELLOTIK_PARSE_URL=https://www.hellotik.app/api/parse
# 鉴权方式：bearer（默认）| x-api-key | raw（整段 Authorization 内容）
# HELLOTIK_AUTH_MODE=bearer
# 若请求体里链接字段不是 url，可改：HELLOTIK_BODY_URL_KEY=link
# 若返回 JSON 字段与默认不一致，可设：HELLOTIK_JSON_PATH=data.xxx

# --- 解析成功后是否在云端下载视频并上传云存储（默认开启，预览走临时链接更快、少配 downloadFile 域名）---
# EXTRACT_SERVER_UPLOAD=0

# --- 解析成功写订单表（可选，便于统计；非微信支付订单）---
# RECORD_ORDER_ON_SUCCESS=1

# --- 腾讯云语音识别（首页「提取文案」：录音文件识别 CreateRecTask / DescribeTaskStatus，API 版本 2019-06-14）---
# 控制台开通「语音识别」后，在访问管理创建 API 密钥：
# TENCENT_SECRET_ID=AKIDxxxxxxxx
# TENCENT_SECRET_KEY=xxxxxxxx
# TENCENT_ASR_REGION=ap-guangzhou
# 说明：通过云存储临时 URL 提交，腾讯云需能公网下载该链接（常见 mp3/m4a/wav/mp4 等；时长可达数分钟，以控制台配额为准）

# --- 上传类工具（首页：本地上传预览 / 提取文案 / 压缩 / MD5）---
# 视频压缩（COS 数据万象媒体转码）：与语音识别共用 TENCENT_SECRET_ID / TENCENT_SECRET_KEY
# 另需：与小程序同地域的 COS 存储桶、以及数据万象「转码模板」ID（控制台 数据万象 → 公共处理参数 → 模板）
# TENCENT_COS_BUCKET=example-1250000000
# TENCENT_COS_REGION=ap-guangzhou
# TENCENT_CI_TRANSCODE_TEMPLATE_ID=txxxxxxxx
# 说明：云函数将用户上传的 mp4 同步到该桶，按模板异步转码，再拉回微信云存储。长视频（compressLongVideo）在已配置上述变量时会自动走该链路。
