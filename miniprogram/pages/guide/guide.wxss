page {
  background: #fff9f3;
  height: 100%;
}

.page-guide {
  height: 100vh;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

.nav-bar {
  flex-shrink: 0;
  background: linear-gradient(165deg, #ffe0eb 0%, #fff2ea 42%, #fff8df 100%);
}

.nav-inner {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 12rpx 0 8rpx;
}

.nav-back {
  width: 72rpx;
  height: 72rpx;
  line-height: 64rpx;
  text-align: center;
  font-size: 56rpx;
  color: #5a3844;
  font-weight: 300;
}

.nav-title {
  flex: 1;
  text-align: center;
  font-size: 34rpx;
  font-weight: 600;
  color: #5a3844;
}

.nav-placeholder {
  width: 72rpx;
}

.guide-scroll {
  flex: 1;
  height: 0;
  padding: 24rpx;
  box-sizing: border-box;
}

.guide-card {
  background: #fffcfa;
  border-radius: 16rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 20rpx;
  box-shadow:
    0 4rpx 20rpx rgba(232, 140, 168, 0.08),
    0 2rpx 10rpx rgba(255, 214, 140, 0.06);
}

.guide-lead {
  font-size: 30rpx;
  line-height: 1.65;
  color: rgba(0, 0, 0, 0.78);
}

.step-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #b85d78;
  margin-bottom: 12rpx;
}

.step-body {
  display: block;
  font-size: 28rpx;
  line-height: 1.65;
  color: rgba(0, 0, 0, 0.65);
}

.guide-tip {
  border: 1rpx solid rgba(232, 160, 180, 0.4);
}

.tip-label {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #b85d78;
  margin-bottom: 10rpx;
}
