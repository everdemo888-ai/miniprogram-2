<view class="page-mine">
  <view class="status-spacer" style="height: {{statusBarHeight}}px;"></view>

  <view class="user-header">
    <image class="avatar" src="/images/avatar-default.svg" mode="aspectFill" />
    <view class="user-meta">
      <text class="nickname">{{nickname}}</text>
      <text class="user-id">ID: {{userId}}</text>
    </view>
  </view>

  <view class="stats-card">
    <view class="stat-item">
      <text class="stat-value">{{points}}</text>
      <text class="stat-label">积分</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item">
      <text class="stat-value stat-value-sm">{{checkedInToday ? "已签" : "未签"}}</text>
      <text class="stat-label">今日签到</text>
    </view>
  </view>

  <view class="menu-section">
    <view class="menu-row" bindtap="onOrders">
      <view class="menu-left">
        <image class="menu-icon" src="/images/icon-clipboard.svg" mode="aspectFit" />
        <text class="menu-label">解析记录</text>
      </view>
      <text class="menu-chevron">›</text>
    </view>
    <view class="menu-divider"></view>

    <view class="menu-row" bindtap="onUsage">
      <view class="menu-left">
        <image class="menu-icon" src="/images/icon-book.svg" mode="aspectFit" />
        <text class="menu-label">使用记录</text>
      </view>
      <text class="menu-chevron">›</text>
    </view>
    <view class="menu-divider"></view>

    <view class="menu-row" bindtap="onCheckIn">
      <view class="menu-left">
        <image class="menu-icon" src="/images/icon-calendar.svg" mode="aspectFit" />
        <text class="menu-label">签到领积分</text>
      </view>
      <view class="menu-right-extra">
        <view class="dot-red" wx:if="{{!checkedInToday}}"></view>
        <text class="menu-extra">+100 积分/天</text>
      </view>
      <text class="menu-chevron">›</text>
    </view>
    <view class="menu-divider"></view>

    <view class="menu-row" bindtap="onFaq">
      <view class="menu-left">
        <image class="menu-icon" src="/images/icon-help.svg" mode="aspectFit" />
        <text class="menu-label">常见问题</text>
      </view>
      <text class="menu-chevron">›</text>
    </view>
    <view class="menu-divider"></view>

    <view class="menu-row menu-row-contact">
      <button
        class="contact-hit-area"
        hover-class="contact-hit-area--hover"
        open-type="contact"
        session-from="mine"
      ></button>
      <view class="menu-left">
        <image class="menu-icon" src="/images/icon-headset.svg" mode="aspectFit" />
        <text class="menu-label">联系客服</text>
      </view>
      <text class="menu-chevron">›</text>
    </view>
  </view>

  <view class="page-bottom-spacer"></view>
</view>
