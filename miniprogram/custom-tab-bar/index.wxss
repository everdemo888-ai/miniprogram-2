.tab-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  display: flex;
  justify-content: space-around;
  align-items: flex-end;
  padding-top: 12rpx;
  background: #fff9f3;
  border-top: 1rpx solid rgba(232, 160, 180, 0.22);
  box-sizing: border-box;
}

.tab-bar-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-bottom: 8rpx;
}

.tab-icon {
  width: 48rpx;
  height: 48rpx;
  margin-bottom: 6rpx;
}

.tab-text {
  font-size: 22rpx;
  color: #9a8a88;
}

.tab-text-active {
  color: #c76b88;
}
