/**app.wxss**/
.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  box-sizing: border-box;
} 

button {
  background: initial;
}

button:focus{
  outline: 0;
}

button::after{
  border: none;
}


/* 全局主题：奶白底 + 淡粉/淡黄点缀（各页 wxss 与之一致） */
page {
  background: #fff9f3;
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
}